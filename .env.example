# ONPU AI Engine - Environment Variables
# Copy this file to .env and configure your local deployment

# Server Settings
ONPU_HOST=127.0.0.1
ONPU_PORT=8000
ONPU_DEBUG=false

# AI Provider API Keys (set your own keys)
OPENAI_API_KEY=your-openai-api-key-here

# Engine Settings
ONPU_DEFAULT_PERSONA=default
ONPU_MAX_PROMPT_LENGTH=4096

# Logging
ONPU_LOG_LEVEL=INFO

# Local Deployment
ONPU_DATA_DIR=./data
ONPU_CACHE_ENABLED=true
